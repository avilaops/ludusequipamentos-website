---
import Foto from './Foto.astro';
import type { Produto } from '../data/site';
import { grupoCatalogo, urlProduto } from '../data/catalogo';

interface Props {
  p: Produto;
  href?: string;
}
const { p, href = urlProduto(p) } = Astro.props;
---

<a
  class="card"
  href={href}
  data-linha={p.linha}
  data-colecao={p.colecao}
  data-grupo={grupoCatalogo(p)}
  data-busca={`${p.code} ${p.nome}`.toLowerCase()}
>
  <div class="stage">
    <Foto code={p.code} alt={`${p.nome} (${p.code})`} />
  </div>
  <div class="txt">
    <span class="colecao">{p.colecao === 'core' ? 'Linha Core' : 'Linha Premium'}</span>
    <span class="code">{p.code}</span>
    <span class="name">{p.nome}</span>
    <span class="meta">{grupoCatalogo(p)}</span>
  </div>
</a>

<style is:global>
  .card .colecao { font-size: 13px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
</style>
