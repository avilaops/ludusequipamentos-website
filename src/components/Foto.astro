---

interface Props {
  code: string;
  alt: string;
  /** Largura de exibição aproximada, para escolher os tamanhos gerados. */
  size?: 'card' | 'full';
  eager?: boolean;
}
const { code, alt, size = 'card', eager = false } = Astro.props;
---

<img src={`/midias/produtos/${code}`} alt={alt} width={size === 'card' ? 800 : 1536} height={size === 'card' ? 600 : 1152} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" />
