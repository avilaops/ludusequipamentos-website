---
import { colecoes, selecionarColecao } from '../data/catalogo';
import type { Produto } from '../data/site';
interface Props { atual?: Produto['colecao']; }
const { atual } = Astro.props;
---
<nav class="colecoes" aria-label="Selecionar linha de equipamentos">
  <a href="/loja/" aria-current={!atual ? 'page' : undefined}>Todas as linhas <span>{selecionarColecao().length}</span></a>
  {colecoes.map((colecao) => <a href={colecao.href} aria-current={atual === colecao.id ? 'page' : undefined}>{colecao.nome} <span>{selecionarColecao(colecao.id).length}</span></a>)}
</nav>
<style>
  .colecoes { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 28px; }
  a { display: flex; align-items: center; gap: 12px; border: 1px solid var(--line); border-radius: 999px; padding: 12px 20px; text-decoration: none; background: var(--surface); }
  a[aria-current='page'] { background: var(--ink); color: var(--surface); border-color: var(--ink); }
  span { font-size: 12px; opacity: .75; }
</style>
