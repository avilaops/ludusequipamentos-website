---
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/500.css';
import '@fontsource/barlow/600.css';
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import logoRetangular from '../assets/marca/ludus-retangular.jpg';
import { empresa, whatsapp } from '../data/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  jsonLd?: Record<string, unknown>;
}
const { title, description, image, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const logo = await getImage({ src: logoRetangular, width: 360, format: 'webp' });
const wa = whatsapp('Olá! Vim pelo site da Ludus e quero um orçamento.');
const indexar = import.meta.env.PUBLIC_INDEXAR !== '0';
const gtm = import.meta.env.PUBLIC_GTM_ID ?? '';
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: empresa.nome,
  email: empresa.email,
  telephone: `+${empresa.whatsappNumero}`,
  address: empresa.endereco,
  url: Astro.site?.href,
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#111110" />
    {/* Domínio definitivo é indexado. PUBLIC_INDEXAR=0 tira dos buscadores (ex.: ambiente de teste). */}
    {!indexar && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd ?? org)} />
  </head>
  <body>
    <header class="top">
      <div class="wrap">
        <a class="logo" href="/" aria-label="Ludus Equipamentos, página inicial">
          <img src={logo.src} alt="Ludus" width="88" height="28" />
        </a>
        <button class="menu-btn" aria-label="Abrir menu" aria-expanded="false" aria-controls="menu">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"></path></svg>
        </button>
        <nav id="menu">
          <a href="/loja/" aria-current={path.startsWith('/loja') ? 'page' : undefined}>Loja</a>
          <a href="/simulador/" aria-current={path.startsWith('/simulador') ? 'page' : undefined}>Simulador</a>
          <a href="/kits/" aria-current={path.startsWith('/kits') ? 'page' : undefined}>Kits</a>
          <a href="/#como-funciona">Como funciona</a>
          <a href="/#contato">Contato</a>
          <a class="btn wa" href={wa} target="_blank" rel="noopener" data-wa="menu">Pedir orçamento</a>
        </nav>
      </div>
    </header>

    <main><slot /></main>

    <footer class="foot">
      <div class="wrap">
        <div class="cols">
          <div>
            <img src={logo.src} alt="Ludus" width="113" height="36" />
            <p>Equipamentos profissionais de musculação, do projeto da sala à entrega e montagem.</p>
          </div>
          <div>
            <h4>Site</h4>
            <a href="/loja/">Loja</a>
            <a href="/simulador/">Simulador de academia</a>
            <a href="/kits/">Kits prontos</a>
            <a href="/#como-funciona">Como funciona</a>
          </div>
          <div>
            <h4>Contato</h4>
            <a href={wa} target="_blank" rel="noopener">WhatsApp {empresa.whatsapp}</a>
            <a href={`mailto:${empresa.email}`}>{empresa.email}</a>
          </div>
        </div>
        <div class="fine">
          <span>© {new Date().getFullYear()} {empresa.nome}</span>
          <span>{empresa.razaoSocial} · CNPJ {empresa.cnpj} · IE {empresa.inscricaoEstadual}</span>
          <span>{empresa.endereco}</span>
        </div>
      </div>
    </footer>

    <div class="cookies" id="cookies" hidden role="dialog" aria-label="Cookies de medição">
      <p>Usamos cookies de medição para saber quais equipamentos interessam mais e melhorar o site. Você pode aceitar ou recusar.</p>
      <div>
        <button class="btn sm ghost" data-cookies="nao">Recusar</button>
        <button class="btn sm" data-cookies="sim">Aceitar</button>
      </div>
    </div>

    <script is:inline define:vars={{ gtm }}>
      // Eventos do site ficam em window.dataLayer. O Tag Manager só é carregado com um
      // ID configurado (PUBLIC_GTM_ID) e depois do aceite de cookies.
      window.dataLayer = window.dataLayer || [];
      window.ludusEvento = (evento, dados) => window.dataLayer.push({ event: evento, ...(dados || {}) });
      const carregar = () => {
        if (!gtm || window.__gtm) return;
        window.__gtm = true;
        window.dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' });
        const s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtm.js?id=' + gtm;
        document.head.appendChild(s);
      };
      let escolha = null;
      try { escolha = localStorage.getItem('ludus-cookies'); } catch {}
      const aviso = document.getElementById('cookies');
      if (escolha === 'sim') carregar();
      else if (!escolha && gtm) aviso.hidden = false;
      aviso.querySelectorAll('[data-cookies]').forEach((b) =>
        b.addEventListener('click', () => {
          try { localStorage.setItem('ludus-cookies', b.dataset.cookies); } catch {}
          aviso.hidden = true;
          if (b.dataset.cookies === 'sim') carregar();
        })
      );
      document.addEventListener('click', (ev) => {
        const a = ev.target.closest && ev.target.closest('[data-wa]');
        if (a) window.ludusEvento('clique_whatsapp', { origem: a.dataset.wa });
      });
      document.addEventListener('ludus:3d', (ev) => {
        const art = ev.target.closest && ev.target.closest('[data-code]');
        window.ludusEvento('interacao_3d', { codigo: art ? art.dataset.code : '' });
      });
      if (new URLSearchParams(location.search).get('origem') === 'catalogo') window.ludusEvento('visita_qr', { pagina: location.pathname });
    </script>

    <script>
      const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
      const menu = document.getElementById('menu');
      btn?.addEventListener('click', () => {
        const open = menu!.classList.toggle('open');
        btn.setAttribute('aria-expanded', String(open));
      });
      const io = new IntersectionObserver(
        (es) => es.forEach((e) => e.isIntersecting && (e.target.classList.add('in'), io.unobserve(e.target))),
        { rootMargin: '0px 0px -4% 0px' }
      );
      document.querySelectorAll('.rv').forEach((el) => io.observe(el));
      // Rede de segurança: nada fica invisível se o observador não disparar.
      setTimeout(() => document.querySelectorAll('.rv:not(.in)').forEach((el) => el.getBoundingClientRect().top < innerHeight && el.classList.add('in')), 1200);
    </script>
  </body>
</html>
