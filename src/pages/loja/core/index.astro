---
import Base from '../../../layouts/Base.astro';
import Card from '../../../components/Card.astro';
import Foto from '../../../components/Foto.astro';
import Colecoes from '../../../components/Colecoes.astro';
import { Image } from 'astro:assets';
import logoCore from '../../../assets/marca/ludus-core.png';
import { catalogoCore, gruposCore, produtosCore } from '../../../data/core';
---

<Base title="Linha Core · Ludus Equipamentos" description="Conheça os 66 equipamentos da Linha Core. Explore por grupo corporal, confira fotos e medidas em milímetros e peça seu orçamento.">
  <section class="dark hero">
    <div class="wrap hero-grid">
      <div class="apresentacao">
        <span class="kicker">Linha Core</span>
        <h1 class="marca-core"><Image src={logoCore} alt="Ludus Core" width={520} loading="eager" /></h1>
        <p class="lead">A base de uma academia completa. Equipamentos organizados para você comparar e escolher.</p>
        <div class="acoes">
          <a class="btn" href="#equipamentos">Explorar equipamentos</a>
          <a class="btn ghost" href={catalogoCore} target="_blank" rel="noopener">Catálogo em PDF</a>
        </div>
        <dl><div><dt>66</dt><dd>equipamentos</dd></div><div><dt>7</dt><dd>grupos corporais</dd></div><div><dt>mm</dt><dd>medidas nas fichas</dd></div></dl>
      </div>
      <a href="/core/ld-wh002/" class="hero-foto stage" aria-label="Conhecer Agachamento Pêndulo LD-WH002">
        <Foto code="LD-WH002" alt="Agachamento Pêndulo Ludus Core" size="full" eager />
        <span>LD-WH002 · Agachamento Pêndulo</span>
      </a>
    </div>
  </section>
  <section class="wrap catalogo" id="equipamentos">
    <Colecoes atual="core" />
    <div class="sec-head"><span class="kicker">Encontre seu equipamento</span><h2>Seu treino. Sua seleção.</h2><p class="lead">Fotos, ficha técnica e dimensões de cada modelo. Orçamento direto com a Ludus.</p></div>
    <form class="filtros" role="search" action="/loja/core/#equipamentos" method="get">
      <label for="busca-core">Buscar por nome ou código</label>
      <div class="campo"><input id="busca-core" name="q" type="search" placeholder="Ex.: leg press ou LD-WH001" /><button type="button" class="btn ghost sm" id="limpar-core">Limpar filtros</button></div>
      <fieldset><legend>Grupo corporal</legend><div class="chips">
        <button type="button" class="chip" data-grupo="" aria-pressed="true">Todos · 66</button>
        {gruposCore.map((g) => <button type="button" class="chip" data-grupo={g.slug} aria-pressed="false">{g.nome} · {produtosCore.filter((p) => p.grupo_muscular === g.nome).length}</button>)}
      </div></fieldset>
      <p id="contagem-core" aria-live="polite">66 equipamentos</p>
    </form>
    <div class="grid-prod" id="grade-core">{produtosCore.map((p) => <Card p={p} href={`/core/${p.slug}/`} />)}</div>
    <p id="vazio-core" hidden>Nenhum equipamento encontrado. Tente outro nome ou limpe os filtros.</p>
    <noscript><p>Os 66 equipamentos estão disponíveis abaixo. Ative o JavaScript para filtrar a seleção.</p></noscript>
  </section>
</Base>

<script>
  import { gruposCore } from '../../../data/core';
  const normalizar = (value: string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
  const busca = document.querySelector<HTMLInputElement>('#busca-core')!;
  const cards = [...document.querySelectorAll<HTMLElement>('#grade-core .card')];
  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-grupo].chip')];
  const contagem = document.querySelector('#contagem-core')!;
  const vazio = document.querySelector<HTMLElement>('#vazio-core')!;
  let grupo = '';
  const aplicar = (atualizarUrl = true) => {
    const nome = gruposCore.find((g) => g.slug === grupo)?.nome;
    const consulta = normalizar(busca.value);
    let quantidade = 0;
    for (const card of cards) {
      card.hidden = Boolean((nome && card.dataset.grupo !== nome) || !normalizar(card.dataset.busca ?? '').includes(consulta));
      if (!card.hidden) quantidade++;
    }
    chips.forEach((chip) => chip.setAttribute('aria-pressed', String(chip.dataset.grupo === grupo)));
    contagem.textContent = `${quantidade} ${quantidade === 1 ? 'equipamento' : 'equipamentos'}`;
    vazio.hidden = quantidade > 0;
    if (atualizarUrl) {
      const url = new URL(location.href);
      if (grupo) url.searchParams.set('grupo', grupo); else url.searchParams.delete('grupo');
      if (busca.value.trim()) url.searchParams.set('q', busca.value.trim()); else url.searchParams.delete('q');
      history.replaceState(null, '', url);
    }
    for (const link of document.querySelectorAll<HTMLAnchorElement>('.colecoes a')) {
      const url = new URL(link.href);
      url.search = '';
      if (grupo) url.searchParams.set('grupo', grupo);
      if (busca.value.trim()) url.searchParams.set('q', busca.value.trim());
      link.href = url.href;
    }
  };
  const lerUrl = () => {
    const params = new URLSearchParams(location.search);
    grupo = gruposCore.some((g) => g.slug === params.get('grupo')) ? params.get('grupo')! : '';
    busca.value = params.get('q') ?? '';
    aplicar(false);
  };
  chips.forEach((chip) => chip.addEventListener('click', () => { grupo = chip.dataset.grupo ?? ''; aplicar(); }));
  busca.addEventListener('input', () => aplicar());
  document.querySelector('#limpar-core')!.addEventListener('click', () => { grupo = ''; busca.value = ''; aplicar(); busca.focus(); });
  document.querySelector('.filtros')!.addEventListener('submit', (event) => { event.preventDefault(); aplicar(); });
  window.addEventListener('popstate', lerUrl);
  lerUrl();
</script>

<style>
  .hero { padding-block: clamp(40px, 6vw, 80px); }
  .hero-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
  .apresentacao { display: grid; gap: 22px; }
  .marca-core { width: min(100%, 460px); }
  .marca-core :global(img) { width: 100%; height: auto; filter: url(#core-logo-alpha); }
  .acoes, dl { display: flex; flex-wrap: wrap; gap: 12px; }
  dl { gap: 40px; border-top: 1px solid var(--dark-line); padding-top: 24px; }
  dt { font: 600 36px/1 var(--display); }
  dd { font-size: 13px; color: var(--dark-muted); margin-top: 6px; }
  .hero-foto { position: relative; aspect-ratio: 1; background: white; }
  .hero-foto span { position: absolute; bottom: 16px; left: 20px; color: var(--ink); font-size: 13px; }
  .catalogo { padding-block: 56px 96px; scroll-margin-top: 84px; }
  .filtros { display: grid; gap: 14px; margin-bottom: 28px; }
  .filtros label, legend { font-size: 13px; font-weight: 600; }
  fieldset { border: 0; min-width: 0; }
  legend { margin-bottom: 10px; }
  .campo { display: flex; gap: 12px; flex-wrap: wrap; }
  input { font: inherit; background: white; border: 1px solid var(--line); border-radius: 30px; padding: 13px 20px; width: min(100%, 440px); }
  #contagem-core { color: var(--muted); font-size: 14px; }
  #vazio-core { padding: 48px 0; text-align: center; }
  @media (max-width: 800px) { .hero-grid { grid-template-columns: 1fr; gap: 28px; } .hero-foto { max-height: 460px; } }
  @media (max-width: 600px) { .catalogo :global(.grid-prod) { grid-template-columns: 1fr 1fr; gap: 12px; } .catalogo :global(.card .name) { font-size: 21px; } dl { gap: 28px; } }
</style>
