---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import Foto from '../../components/Foto.astro';
import { areaTreino, coresBraco, coresEstrutura, empresa, fmt, FOLGA, produtos, whatsapp, type Produto } from '../../data/site';
import { planta } from '../../data/modelos';
import { musculos } from '../../data/musculos';

export function getStaticPaths() {
  return produtos.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Produto };
const [c, l, a] = p.dim;
const wa = whatsapp(`Olá! Vi o ${p.nome} (${p.code}) no site e quero um orçamento.`);
const svg = planta(p.code);
const musc = musculos(p);
const relacionados = [
  ...produtos.filter((x) => x.code !== p.code && x.grupo_muscular === p.grupo_muscular && x.linha === p.linha),
  ...produtos.filter((x) => x.code !== p.code && x.grupo_muscular === p.grupo_muscular && x.linha !== p.linha),
].slice(0, 4);
const fotos = import.meta.glob<{ default: ImageMetadata }>('../../assets/produtos/*.jpg', { eager: true });
const og = await getImage({ src: fotos[`../../assets/produtos/${p.code}.jpg`].default, width: 1200, format: 'jpg' });
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${p.nome} ${p.code}`,
  sku: p.code,
  brand: { '@type': 'Brand', name: empresa.marca },
  category: `${p.linha} · ${p.grupo_muscular}`,
  description: p.descricao,
  image: new URL(og.src, Astro.site).href,
};
---

<Base title={`${p.nome} ${p.code} · Ludus Equipamentos`} description={p.descricao.slice(0, 155)} image={og.src} jsonLd={jsonLd}>
  <article class="wrap prod" data-code={p.code}>
    <nav class="crumb" aria-label="Você está em">
      <a href="/loja/">Loja</a> / <a href={`/loja/?linha=${p.linha === 'Peso livre' ? 'peso-livre' : p.linha === 'Bateria de pesos' ? 'bateria-de-pesos' : 'bancos-e-suportes'}`}>{p.linha}</a> / {p.grupo_muscular}
    </nav>

    <div class="topo">
      <div class="midia">
        <div class="stage foto">
          <Foto code={p.code} alt={`${p.nome} ${p.code}`} size="full" eager />
        </div>
      </div>

      <div class="info">
        <span class="code">{p.code}</span>
        <h1>{p.nome}</h1>
        <p class="sub">{p.linha} · {p.grupo_muscular}</p>
        <p class="desc">{p.descricao}</p>
        <div class="cta">
          <a class="btn wa" href={wa} target="_blank" rel="noopener" data-wa={p.code}>Pedir orçamento no WhatsApp</a>
          <a class="btn ghost" href={`/simulador/?add=${p.code}`}>Colocar na minha academia</a>
        </div>
        <table class="ficha">
          <tbody>
            <tr><td>Dimensões (C × L × A)</td><td>{c} × {l} × {a} mm</td></tr>
            {p.peso && <tr><td>Peso do equipamento</td><td>{p.peso}</td></tr>}
            {p.bateria ? <tr><td>Bateria de pesos</td><td>{p.bateria}</td></tr> : p.linha === 'Peso livre' ? <tr><td>Carga</td><td>Anilhas</td></tr> : null}
            <tr><td>Área de treino</td><td>{fmt(areaTreino(p))} m²</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <section class="bloco duas">
      <div>
        <h2>Espaço necessário</h2>
        <p class="lead">
          O equipamento ocupa {fmt(l / 1000, 2)} × {fmt(c / 1000, 2)} m. Com {FOLGA * 100} cm de folga em volta para uso e circulação, reserve {fmt(areaTreino(p))} m².
        </p>
        <a class="btn ghost" href={`/simulador/?add=${p.code}`}>Testar na planta da minha sala</a>
      </div>
      {svg && <div class="planta" set:html={svg} />}
    </section>

    {
      musc && (
        <section class="bloco">
          <h2>Músculos trabalhados</h2>
          <div class="musc">
            {musc.principais.map((m) => <span class="m p">{m}</span>)}
            {musc.auxiliares.map((m) => <span class="m">{m}</span>)}
          </div>
          <p class="nota"><span class="m p mini"></span> principal <span class="m mini"></span> auxiliar</p>
        </section>
      )
    }

    <section class="bloco">
      <h2>Cores</h2>
      <div class="cores">
        <div>
          <h3>Estrutura</h3>
          <ul>{coresEstrutura.map(([n, h]) => <li><i style={`background:${h}`}></i>{n}</li>)}</ul>
        </div>
        {
          p.linha === 'Peso livre' && (
            <div>
              <h3>Braços</h3>
              <ul>{coresBraco.map(([n, h]) => <li><i style={`background:${h}`}></i>{n}</li>)}</ul>
            </div>
          )
        }
      </div>
    </section>

    {
      relacionados.length > 0 && (
        <section class="bloco">
          <h2>Combina com</h2>
          <div class="grid-prod">{relacionados.map((r) => <Card p={r} />)}</div>
        </section>
      )
    }

    <section class="bloco fale">
      <h2>Fale com a Ludus</h2>
      <p class="lead">Orçamento, prazo e condições deste equipamento, direto com um consultor.</p>
      <div class="cta">
        <a class="btn wa" href={wa} target="_blank" rel="noopener" data-wa={p.code}>WhatsApp {empresa.whatsapp}</a>
        <a class="btn ghost" href={`mailto:${empresa.email}?subject=${encodeURIComponent(`Orçamento ${p.nome} (${p.code})`)}`}>{empresa.email}</a>
      </div>
    </section>
  </article>

  <div class="fixo">
    <a class="btn wa" href={wa} target="_blank" rel="noopener" data-wa={p.code}>Pedir orçamento no WhatsApp</a>
  </div>
</Base>

<style>
  .prod { padding-block: 20px 120px; }
  .crumb { font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); padding-block: 8px 20px; }
  .crumb a { text-decoration: none; }
  .crumb a:hover { color: var(--ink); }
  .topo { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: clamp(24px, 4vw, 56px); align-items: start; }
  .midia { position: sticky; top: 88px; display: grid; gap: 12px; }
  .stage.foto { aspect-ratio: 1 / 1; }
  .info { display: grid; gap: 14px; }
  h1 { font-size: clamp(44px, 6vw, 76px); }
  .sub { color: var(--muted); font-size: 14px; letter-spacing: 0.12em; text-transform: uppercase; }
  .desc { font-size: 18px; }
  .cta { display: flex; flex-wrap: wrap; gap: 10px; margin-block: 6px 10px; }
  .nota { font-size: 13px; color: var(--muted); margin-top: 10px; }
  .bloco { margin-top: clamp(48px, 7vw, 88px); display: grid; gap: 20px; }
  .bloco h2 { font-size: clamp(30px, 4vw, 44px); }
  .duas { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; gap: clamp(24px, 4vw, 56px); }
  .duas > div:first-child { display: grid; gap: 18px; justify-items: start; }
  .planta { background: var(--surface); border: 1px solid var(--line); border-radius: 18px; padding: 16px; }
  .planta :global(svg) { width: 100%; height: auto; max-height: 460px; display: block; }
  .cores { display: flex; flex-wrap: wrap; gap: 24px 56px; }
  .cores h3 { font: 600 12px/1 var(--body); letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); margin-bottom: 12px; }
  .cores ul { list-style: none; display: flex; flex-wrap: wrap; gap: 10px 18px; }
  .cores li { display: flex; align-items: center; gap: 8px; font-size: 15px; }
  .cores i { width: 26px; height: 26px; border-radius: 50%; border: 1px solid rgba(0, 0, 0, 0.18); }
  .musc { display: flex; flex-wrap: wrap; gap: 8px; }
  .m { font: 500 15px/1 var(--body); padding: 10px 16px; border-radius: 999px; border: 1.5px solid var(--ink); }
  .m.p { background: var(--ink); color: #fff; }
  .m.mini { display: inline-block; padding: 0; width: 12px; height: 12px; vertical-align: -1px; margin-left: 10px; }
  .fale { background: var(--dark); color: var(--dark-ink); border-radius: 26px; padding: clamp(28px, 5vw, 56px); }
  .fale .lead { color: var(--dark-muted); }
  .fale .btn.ghost { color: var(--dark-ink); border-color: #55524c; }
  .fixo { display: none; }
  @media (max-width: 900px) {
    .topo, .duas { grid-template-columns: 1fr; }
    .midia { position: static; }
    .fixo { display: block; position: fixed; left: 0; right: 0; bottom: 0; z-index: 15; padding: 10px 16px calc(10px + env(safe-area-inset-bottom, 0px)); background: rgba(246, 245, 242, 0.94); backdrop-filter: blur(8px); border-top: 1px solid var(--line); }
    .fixo .btn { width: 100%; }
    .info .cta .btn { width: 100%; }
  }
</style>
