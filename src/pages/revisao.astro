---
// Página interna de revisão: foto do catálogo ao lado do modelo 3D, para os 94 equipamentos.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import { linhas, produtos } from '../data/site';

const renders = import.meta.glob<{ default: ImageMetadata }>(
  '/node_modules/@avilaops/gerador-3d/catalogs/ludus/models/*/thumb.png',
  { eager: true }
);
const render = (code: string) =>
  renders[`/node_modules/@avilaops/gerador-3d/catalogs/ludus/models/${code}/thumb.png`]?.default;
---

<Base title="Revisão foto × 3D · Ludus Equipamentos" description="Comparação interna entre a foto do catálogo e o modelo 3D de cada equipamento.">
  <section class="wrap rev">
    <span class="kicker">Revisão interna</span>
    <h1>Foto × modelo 3D</h1>
    <p class="lead">Os {produtos.length} equipamentos, com a foto do catálogo à esquerda e o modelo 3D à direita. Clique para abrir a página do produto.</p>
    <nav class="chips">{linhas.map((l) => <a class="chip" href={`#${l.slug}`}>{l.titulo}</a>)}</nav>
    {
      linhas.map((l) => (
        <>
          <h2 id={l.slug}>{l.titulo}</h2>
          <div class="pares">
            {produtos
              .filter((p) => p.linha === l.id)
              .map((p) => (
                <a class="par" href={`/loja/${p.slug}/?3d`}>
                  <div class="imgs">
                    <div class="stage"><Foto code={p.code} alt={`Foto: ${p.nome}`} /></div>
                    <div class="stage r">{render(p.code) && <Image src={render(p.code)!} alt={`Modelo 3D: ${p.nome}`} widths={[360, 600]} sizes="(max-width: 700px) 46vw, 300px" loading="lazy" />}</div>
                  </div>
                  <div class="txt"><span class="code">{p.code}</span> <b>{p.nome}</b></div>
                </a>
              ))}
          </div>
        </>
      ))
    }
  </section>
</Base>

<style>
  .rev { padding-block: 32px 96px; display: grid; gap: 16px; }
  h1 { font-size: clamp(40px, 6vw, 72px); }
  h2 { font-size: clamp(28px, 4vw, 40px); margin-top: 28px; scroll-margin-top: 90px; }
  .pares { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 16px; }
  .par { background: var(--surface); border: 1px solid var(--line); border-radius: 16px; overflow: hidden; text-decoration: none; }
  .par:hover { border-color: var(--accent); }
  .imgs { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--line); }
  .imgs .stage { border-radius: 0; aspect-ratio: 1; }
  .imgs .stage.r :global(img) { padding: 0; mix-blend-mode: normal; }
  .txt { padding: 10px 14px 12px; font-size: 15px; }
</style>
