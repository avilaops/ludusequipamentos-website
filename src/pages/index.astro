---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import Foto from '../components/Foto.astro';
import Viewer3D from '../components/Viewer3D.astro';
import PlantaKit from '../components/PlantaKit.astro';
import Contato from '../components/Contato.astro';
import { empresa, kits, linhas, porCodigo, produtos, whatsapp } from '../data/site';

const wa = whatsapp('Olá! Vim pelo site da Ludus e quero um orçamento.');
const destaques = ['LD-A034', 'LD-A023', 'LD-B004', 'LD-A002', 'LD-B038', 'LD-A036', 'LD-B012', 'LD-A050'].map(
  (c) => porCodigo.get(c)!
);
const slugs = Object.fromEntries(produtos.map((p) => [p.code, p.slug]));
const tbd = 'a confirmar';
---

<Base
  title="Ludus Equipamentos · Musculação profissional, do projeto à entrega"
  description="94 equipamentos de musculação Ludus Premium. Veja cada um em 3D, monte a planta da sua academia no simulador e peça o orçamento pelo WhatsApp."
>
  <!-- Links antigos do QR (/?id=LD-B004) levam à página do equipamento. -->
  <script is:inline define:vars={{ slugs }}>
    const id = new URLSearchParams(location.search).get('id');
    if (id && slugs[id]) location.replace(`/loja/${slugs[id]}/`);
  </script>

  <section class="hero dark">
    <div class="wrap hero-grid">
      <div class="hero-txt">
        <span class="kicker">Ludus Premium · Equipamentos de musculação</span>
        <h1>Força profissional, <em>do projeto à entrega.</em></h1>
        <p class="lead">
          Você escolhe os equipamentos, vê cada um em 3D e monta a planta da sua academia em escala. A Ludus entrega, monta e deixa pronto para o primeiro treino.
        </p>
        <div class="cta">
          <a class="btn" href="/loja/">Ver os 94 equipamentos</a>
          <a class="btn ghost" href="/simulador/">Monte sua academia</a>
        </div>
        <dl class="stats">
          <div><dt>94</dt><dd>equipamentos</dd></div>
          <div><dt>3</dt><dd>linhas</dd></div>
          <div><dt>3D</dt><dd>em cada produto</dd></div>
          <div><dt>1:1</dt><dd>planta em escala</dd></div>
        </dl>
      </div>
      <a class="hero-foto stage" href={`/loja/${slugs['LD-A030']}/`} aria-label="Agachamento Pendulum LD-A030">
        <Foto code="LD-A030" alt="Agachamento Pendulum Ludus Premium" size="full" eager />
        <span class="tag"><b>LD-A030</b> Agachamento Pendulum</span>
      </a>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="sec-head rv">
        <span class="kicker">Linhas</span>
        <h2>Tudo para uma sala completa</h2>
        <p class="lead">Três linhas que se combinam: do corpo inteiro na bateria de pesos à área de peso livre.</p>
      </div>
      <div class="linhas">
        {
          linhas.map((l, i) => (
            <a class="linha rv" href={`/loja/?linha=${l.slug}`}>
              <div class="stage">
                <Foto code={l.destaque} alt={l.titulo} />
              </div>
              <div class="linha-txt">
                <span class="num">0{i + 1}</span>
                <h3>{l.titulo}</h3>
                <p>{l.resumo}</p>
                <span class="more">{produtos.filter((p) => p.linha === l.id).length} equipamentos →</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="sec dark sim">
    <div class="wrap sim-grid">
      <div class="rv">
        <span class="kicker">Simulador</span>
        <h2>Monte sua academia antes de comprar</h2>
        <p class="lead">
          Informe as medidas da sala, arraste os equipamentos para a planta e veja o resultado em 3D. Cada peça entra em escala, com a área de treino em volta, para você saber o que cabe.
        </p>
        <ul class="ticks">
          <li>Planta em escala com os 94 equipamentos</li>
          <li>Área de treino e circulação calculadas na hora</li>
          <li>Visão 3D da sala montada</li>
          <li>Envie o projeto para a Ludus e receba o orçamento</li>
        </ul>
        <div class="cta">
          <a class="btn" href="/simulador/">Abrir o simulador</a>
          <a class="btn ghost" href="/kits/">Ver os kits prontos</a>
        </div>
      </div>
      <a class="sim-planta rv" href="/simulador/?kit=studio" aria-label="Abrir o Kit Studio no simulador">
        <PlantaKit kit={kits[0]} dark />
        <span class="cap">Kit Studio · 15 × 10 m · 17 equipamentos</span>
      </a>
    </div>
  </section>

  <section class="sec">
    <div class="wrap tresd">
      <div class="rv">
        <Viewer3D code="LD-A002" />
      </div>
      <div class="rv">
        <span class="kicker">Cada produto em 3D</span>
        <h2>Gire, aproxime e veja o movimento</h2>
        <p class="lead">
          Todo equipamento da loja tem um modelo 3D com as medidas reais. Dá para ver o movimento do exercício, a área de treino e a altura ao lado de uma pessoa de 1,75 m.
        </p>
        <p class="hint">Arraste o modelo ao lado. É o Supino e Remada LD-A002.</p>
        <div class="cta"><a class="btn" href={`/loja/${slugs['LD-A002']}/`}>Ver este equipamento</a></div>
      </div>
    </div>
  </section>

  <section class="sec alt">
    <div class="wrap">
      <div class="sec-head rv">
        <span class="kicker">Loja</span>
        <h2>Destaques da loja</h2>
      </div>
      <div class="grid-prod">{destaques.map((p) => <Card p={p} />)}</div>
      <div class="cta center"><a class="btn" href="/loja/">Ver a loja completa</a></div>
    </div>
  </section>

  <section class="sec dark" id="como-funciona">
    <div class="wrap">
      <div class="sec-head rv">
        <span class="kicker">Como funciona</span>
        <h2>Do pedido ao primeiro treino</h2>
      </div>
      <ol class="steps">
        <li class="rv"><span class="num">1</span><h3>Envie a planta</h3><p>As medidas do espaço ou a planta do imóvel. Se preferir, monte você mesmo no simulador.</p></li>
        <li class="rv"><span class="num">2</span><h3>Receba o layout</h3><p>Os equipamentos em escala, com circulação e área de treino de cada um.</p></li>
        <li class="rv"><span class="num">3</span><h3>Aprove a proposta</h3><p>Lista final, prazo e condições em um só documento.</p></li>
        <li class="rv"><span class="num">4</span><h3>Entrega e montagem</h3><p>Equipamentos instalados e prontos para o primeiro treino.</p></li>
      </ol>
      <div class="garantias">
        <div><h4>Garantia</h4><p><span class="tbd">{empresa.garantia ?? tbd}</span></p></div>
        <div><h4>Prazo de entrega</h4><p><span class="tbd">{empresa.prazoEntrega ?? tbd}</span></p></div>
        <div><h4>Formas de pagamento</h4><p><span class="tbd">{empresa.pagamento ?? tbd}</span></p></div>
        <div><h4>Projeto da sala</h4><p>Estudo de layout em planta e 3D antes da compra.</p></div>
      </div>
    </div>
  </section>

  <section class="sec contato" id="contato">
    <div class="wrap contato-grid">
      <div class="rv">
        <span class="kicker">Fale com a Ludus</span>
        <h2>Vamos montar a sua academia</h2>
        <p class="lead">Conte o tamanho do espaço e o que você quer treinar. A resposta vem com a lista de equipamentos e a planta.</p>
        <div class="canais">
        <a class="btn wa" href={wa} target="_blank" rel="noopener" data-wa="contato">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-12.3 7.4L3 21l2.1-5.6A8.4 8.4 0 1 1 21 11.5Z"/></svg>
          WhatsApp {empresa.whatsapp}
        </a>
        <a class="btn ghost" href={`mailto:${empresa.email}`}>{empresa.email}</a>
      </div>
      </div>
      <div class="rv contato-form">
        <Contato />
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: clamp(36px, 6vw, 80px) clamp(48px, 7vw, 96px); overflow: hidden; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); gap: clamp(24px, 4vw, 64px); align-items: center; }
  .hero-txt { display: grid; gap: 22px; }
  h1 em { font-style: normal; color: #c4a274; display: block; }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 6px; }
  .cta.center { justify-content: center; margin-top: 36px; }
  .stats { display: grid; grid-template-columns: repeat(4, auto); gap: 8px 32px; justify-content: start; border-top: 1px solid var(--dark-line); padding-top: 22px; margin-top: 10px; }
  .stats dt { font: 700 38px/1 var(--display); color: #fff; }
  .stats dd { font-size: 13px; color: var(--dark-muted); margin-top: 4px; }
  .hero-foto { position: relative; aspect-ratio: 1 / 1.02; border-radius: 26px; text-decoration: none; background: #e9e7e1; }
  .hero-foto :global(img) { padding: 4%; }
  .hero-foto .tag { position: absolute; left: 16px; bottom: 16px; background: var(--dark); color: var(--dark-ink); border-radius: 999px; padding: 8px 14px; font-size: 13px; }
  .hero-foto .tag b { color: #c4a274; letter-spacing: 0.08em; margin-right: 6px; }

  .linhas { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .linha { background: var(--surface); border: 1px solid var(--line); border-radius: 22px; overflow: hidden; text-decoration: none; display: flex; flex-direction: column; transition: transform 0.18s, box-shadow 0.18s; }
  .linha:hover { transform: translateY(-4px); box-shadow: 0 18px 36px rgba(20, 20, 19, 0.1); }
  .linha .stage { border-radius: 0; aspect-ratio: 4 / 3.3; }
  .linha-txt { padding: 22px 24px 26px; display: grid; gap: 8px; }
  .linha .num { color: var(--accent); font-size: 20px; }
  .linha h3 { font-size: 32px; text-transform: uppercase; }
  .linha p { color: var(--muted); font-size: 16px; }
  .more { font-weight: 600; margin-top: 6px; }

  .sim-grid { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(28px, 5vw, 72px); align-items: center; }
  .sim-grid > div { display: grid; gap: 20px; }
  .ticks { list-style: none; display: grid; gap: 10px; color: var(--dark-ink); }
  .ticks li { padding-left: 28px; position: relative; }
  .ticks li::before { content: ''; position: absolute; left: 0; top: 0.55em; width: 14px; height: 2px; background: #c4a274; }
  .sim-planta { display: block; background: var(--dark-2); border: 1px solid var(--dark-line); border-radius: 22px; padding: clamp(12px, 2vw, 24px); text-decoration: none; transition: border-color 0.2s; }
  .sim-planta:hover { border-color: #c4a274; }
  .sim-planta .cap { display: block; text-align: center; font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--dark-muted); margin-top: 12px; }

  .tresd { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(28px, 5vw, 72px); align-items: center; }
  .tresd > div:last-child { display: grid; gap: 20px; }
  .hint { font-size: 14px; color: var(--muted); }
  .alt { background: #efede8; }

  .steps { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
  .steps li { background: var(--dark-2); border: 1px solid var(--dark-line); border-radius: 20px; padding: 24px; display: grid; gap: 10px; align-content: start; }
  .steps .num { font-size: 54px; color: #c4a274; }
  .steps h3 { text-transform: uppercase; }
  .steps p { color: var(--dark-muted); font-size: 16px; }
  .garantias { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; margin-top: 44px; border-top: 1px solid var(--dark-line); padding-top: 32px; }
  .garantias h4 { font: 600 12px/1 var(--body); letter-spacing: 0.18em; text-transform: uppercase; color: var(--dark-muted); margin-bottom: 10px; }
  .garantias .tbd { color: #c4a274; border-color: #c4a274; }

  .contato-grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(28px, 5vw, 64px); align-items: start; }
  .contato-form { background: var(--surface); border: 1px solid var(--line); border-radius: 22px; padding: clamp(18px, 3vw, 32px); }
  .contato-grid > div:first-child { display: grid; gap: 16px; }
  .canais { display: grid; gap: 12px; margin-top: 10px; }
  .canais .btn { width: 100%; padding-block: 20px; font-size: 17px; }

  @media (max-width: 900px) {
    .hero-grid, .sim-grid, .tresd, .contato-grid { grid-template-columns: 1fr; }
    .linhas { grid-template-columns: 1fr; }
    .steps, .garantias { grid-template-columns: 1fr 1fr; }
    .stats { grid-template-columns: repeat(2, auto); }
    .hero-foto { order: -1; aspect-ratio: 4 / 3; }
  }
  @media (max-width: 520px) { .steps, .garantias { grid-template-columns: 1fr; } .cta .btn { width: 100%; } }
</style>
