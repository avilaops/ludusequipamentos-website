---
import Base from '../../layouts/Base.astro';
import PlantaKit from '../../components/PlantaKit.astro';
import { kits } from '../../data/site';
---

<Base title="Kits prontos · Ludus Equipamentos" description="Academias montadas por tamanho: 150, 300 e 600 m². Veja a planta em escala, a lista de equipamentos e adapte no simulador.">
  <section class="cab dark">
    <div class="wrap">
      <span class="kicker">Kits prontos</span>
      <h1>Academias por tamanho</h1>
      <p class="lead">Três pontos de partida, já com a planta em escala. Abra no simulador, troque o que quiser e peça o orçamento.</p>
    </div>
  </section>
  <section class="wrap lista">
    {
      kits.map((k) => (
        <a class="kit" href={`/kits/${k.id}/`}>
          <div class="pl"><PlantaKit kit={k} /></div>
          <div class="tx">
            <span class="kicker">{k.nome.split(' · ')[0]}</span>
            <h2>{k.titulo}</h2>
            <p>{k.resumo}</p>
            <span class="meta">{k.largura} × {k.profundidade} m · {k.itens.length} equipamentos →</span>
          </div>
        </a>
      ))
    }
  </section>
</Base>

<style>
  .cab { padding-block: clamp(36px, 6vw, 72px); }
  .cab .wrap { display: grid; gap: 12px; }
  .cab h1 { font-size: clamp(42px, 7vw, 84px); }
  .lista { padding-block: 32px 96px; display: grid; gap: 20px; }
  .kit { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: clamp(18px, 3vw, 40px); align-items: center; background: var(--surface); border: 1px solid var(--line); border-radius: 22px; padding: clamp(14px, 2vw, 24px); text-decoration: none; transition: transform 0.18s, box-shadow 0.18s; }
  .kit:hover { transform: translateY(-3px); box-shadow: 0 16px 34px rgba(20, 20, 19, 0.1); }
  .tx { display: grid; gap: 10px; }
  .tx h2 { font-size: clamp(30px, 4vw, 46px); }
  .tx p { color: var(--muted); }
  .meta { font-weight: 600; }
  @media (max-width: 800px) { .kit { grid-template-columns: 1fr; } }
</style>
