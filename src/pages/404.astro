---
import Base from '../layouts/Base.astro';
---

<Base title="Página não encontrada · Ludus Equipamentos" description="Esta página não existe. Veja a loja ou monte sua academia no simulador.">
  <section class="wrap sec" style="display:grid;gap:18px;justify-items:start">
    <span class="kicker">Erro 404</span>
    <h1>Página não encontrada</h1>
    <p class="lead">O endereço pode ter mudado. Os equipamentos continuam na loja.</p>
    <div style="display:flex;flex-wrap:wrap;gap:12px">
      <a class="btn" href="/loja/">Ir para a loja</a>
      <a class="btn ghost" href="/simulador/">Abrir o simulador</a>
    </div>
  </section>
</Base>
