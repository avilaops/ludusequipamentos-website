---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { empresa, FOLGA, kits, linhas, produtos } from '../data/site';

const fotos = import.meta.glob<{ default: ImageMetadata }>('../assets/produtos/*.jpg', { eager: true });
const lista = await Promise.all(
  produtos.map(async (p) => ({
    code: p.code,
    nome: p.nome,
    linha: p.linha,
    slug: p.slug,
    c: p.dim[0] / 1000,
    l: p.dim[1] / 1000,
    foto: (await getImage({ src: fotos[`../assets/produtos/${p.code}.jpg`].default, width: 120, format: 'webp' })).src,
  }))
);
const dados = { produtos: lista, kits, folga: FOLGA, whatsapp: empresa.whatsappNumero };
---

<Base
  title="Simulador · Monte sua academia · Ludus Equipamentos"
  description="Monte a planta da sua academia com os equipamentos Ludus em escala, veja em 3D e envie o projeto para receber o orçamento."
>
  <section class="cab dark">
    <div class="wrap">
      <span class="kicker">Simulador</span>
      <h1>Monte sua academia</h1>
      <p class="lead">Informe o tamanho da sala, adicione os equipamentos e arraste cada um para o lugar. Tudo em escala, com a área de treino em volta.</p>
    </div>
  </section>

  <section class="wrap sim" id="sim">
    <div class="barra">
      <label>Largura <span><input id="larg" type="number" min="3" max="60" step="0.5" value="15" inputmode="decimal" /> m</span></label>
      <label>Profundidade <span><input id="prof" type="number" min="3" max="60" step="0.5" value="10" inputmode="decimal" /> m</span></label>
      <div class="acoes">
        <button class="chip" id="b-kit">Começar pelo Kit Studio</button>
        <button class="chip" id="b-limpar">Limpar</button>
        <button class="chip" id="b-link">Copiar link do projeto</button>
      </div>
    </div>

    <div class="area">
      <aside class="cat" aria-label="Equipamentos para adicionar">
        <input type="search" id="q" placeholder="Buscar equipamento" aria-label="Buscar equipamento" />
        <div class="chips" id="linhas">
          <button class="chip sm" data-v="" aria-pressed="true">Todos</button>
          {linhas.map((l) => <button class="chip sm" data-v={l.id} aria-pressed="false">{l.titulo}</button>)}
        </div>
        <ul id="lista"></ul>
      </aside>

      <div class="palco">
        <div class="modo" role="tablist" aria-label="Planta ou 3D">
          <button class="chip on" data-modo="planta" role="tab" aria-selected="true">Planta</button>
          <button class="chip" data-modo="3d" role="tab" aria-selected="false">Ver em 3D</button>
        </div>
        <div class="tela">
          <svg id="planta" role="application" aria-label="Planta da sala. Arraste os equipamentos para posicionar."></svg>
          <div id="cena" hidden></div>
          <p class="dica" id="dica">Adicione um equipamento da lista para começar.</p>
        </div>
        <div class="sel" id="sel" hidden>
          <b id="sel-nome"></b>
          <button class="chip sm" id="b-girar">Girar 90°</button>
          <button class="chip sm" id="b-dup">Duplicar</button>
          <button class="chip sm" id="b-rem">Remover</button>
          <a class="chip sm" id="b-ver" target="_blank" rel="noopener">Ver ficha</a>
        </div>
      </div>

      <aside class="res" aria-label="Resumo do projeto">
        <h2>Seu projeto</h2>
        <dl>
          <div><dt id="r-n">0</dt><dd>equipamentos</dd></div>
          <div><dt id="r-sala">150 m²</dt><dd>de sala</dd></div>
          <div><dt id="r-ocup">0 m²</dt><dd>ocupados pelas máquinas</dd></div>
          <div><dt id="r-livre">150 m²</dt><dd>de circulação livre</dd></div>
        </dl>
        <p class="aviso" id="aviso" hidden></p>
        <ol id="itens"></ol>
        <a class="btn wa" id="b-wa" target="_blank" rel="noopener">Pedir orçamento deste projeto</a>
        <p class="nota">O pedido abre o WhatsApp da Ludus com a lista dos equipamentos e o link da sua planta. Modelos 3D representativos; a Ludus confere o layout na planta real antes de fechar.</p>
      </aside>
    </div>
  </section>

  <script type="application/json" id="dados" set:html={JSON.stringify(dados)} />
</Base>

<script>
  import '../scripts/simulador';
</script>

<style>
  .cab { padding-block: clamp(32px, 5vw, 64px); }
  .cab .wrap { display: grid; gap: 12px; }
  .cab h1 { font-size: clamp(42px, 7vw, 84px); }
  .sim { padding-block: 24px 96px; max-width: 1480px; }
  .barra { display: flex; flex-wrap: wrap; gap: 12px 24px; align-items: end; margin-bottom: 18px; }
  .barra label { display: grid; gap: 6px; font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); font-weight: 600; }
  .barra label span { font-size: 16px; letter-spacing: 0; text-transform: none; color: var(--ink); }
  .barra input { font: 600 18px/1 var(--body); width: 92px; padding: 10px 12px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); }
  .acoes { display: flex; flex-wrap: wrap; gap: 8px; margin-left: auto; }
  .area { display: grid; grid-template-columns: 290px minmax(0, 1fr) 300px; gap: 18px; align-items: start; }
  .cat, .res { background: var(--surface); border: 1px solid var(--line); border-radius: 18px; padding: 16px; display: grid; gap: 12px; }
  .cat input { font: 400 15px/1 var(--body); padding: 12px 16px; border-radius: 999px; border: 1px solid var(--line); width: 100%; }
  .cat :global(ul) { list-style: none; display: grid; gap: 6px; max-height: 620px; overflow: auto; margin-right: -8px; padding-right: 8px; }
  .cat :global(li button) { display: grid; grid-template-columns: 52px 1fr auto; gap: 10px; align-items: center; width: 100%; text-align: left; background: none; border: 1px solid transparent; border-radius: 12px; padding: 4px 8px 4px 4px; cursor: pointer; font: inherit; color: inherit; }
  .cat :global(li button:hover) { border-color: var(--line); background: var(--bg); }
  .cat :global(li img) { width: 52px; height: 52px; object-fit: contain; background: var(--stage); border-radius: 10px; mix-blend-mode: multiply; }
  .cat :global(li b) { display: block; font-weight: 600; font-size: 14px; line-height: 1.2; }
  .cat :global(li small) { color: var(--muted); font-size: 12px; }
  .cat :global(li .mais) { font: 600 20px/1 var(--body); width: 30px; height: 30px; border-radius: 50%; background: var(--ink); color: #fff; display: grid; place-items: center; }
  .palco { display: grid; gap: 10px; }
  .modo { display: flex; gap: 8px; }
  .tela { position: relative; background: var(--surface); border: 1px solid var(--line); border-radius: 18px; padding: 10px; }
  #planta { width: 100%; height: auto; display: block; touch-action: none; user-select: none; max-height: 72vh; }
  #cena { aspect-ratio: 3 / 2; border-radius: 12px; overflow: hidden; background: var(--stage); }
  #cena :global(canvas) { width: 100%; height: 100%; display: block; cursor: grab; }
  .dica { position: absolute; left: 50%; bottom: 18px; transform: translateX(-50%); background: rgba(255, 255, 255, 0.9); border: 1px solid var(--line); border-radius: 999px; padding: 6px 14px; font-size: 13px; color: var(--muted); pointer-events: none; white-space: nowrap; }
  .sel { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 10px 14px; }
  .sel b { margin-right: auto; }
  .chip.sm { padding: 8px 13px; font-size: 13px; }
  .res h2 { font-size: 28px; }
  .res dl { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .res dt { font: 700 30px/1 var(--display); }
  .res dd { font-size: 12px; color: var(--muted); }
  .aviso { background: #fbe9e7; color: #9c2b20; border-radius: 10px; padding: 10px 12px; font-size: 13px; }
  .res :global(ol) { list-style: none; display: grid; gap: 2px; max-height: 300px; overflow: auto; font-size: 14px; }
  .res :global(ol li) { display: grid; grid-template-columns: 24px 1fr; gap: 6px; padding: 5px 0; border-bottom: 1px solid var(--line); cursor: pointer; }
  .res :global(ol li span) { color: var(--accent); font-weight: 600; font-variant-numeric: tabular-nums; }
  .res .btn { width: 100%; }
  .nota { font-size: 12px; color: var(--muted); line-height: 1.45; }

  #planta :global(.parede) { fill: #141413; }
  #planta :global(.piso) { fill: #fbfaf7; }
  #planta :global(.grade) { stroke: #ebe8e1; stroke-width: 0.012; }
  #planta :global(.zona) { fill: #ebe4d7; }
  #planta :global(.item) { cursor: grab; }
  #planta :global(.item .corpo) { fill: transparent; }
  #planta :global(.item polygon), #planta :global(.item .bloco) { fill: #141413; }
  #planta :global(.item.ruim polygon), #planta :global(.item.ruim .bloco) { fill: #c0392b; }
  #planta :global(.item.sel .corpo) { stroke: #96764a; stroke-width: 0.05; stroke-dasharray: 0.12 0.08; }
  #planta :global(.dot) { fill: #fff; stroke: #141413; stroke-width: 0.03; }
  #planta :global(.n) { font: 600 0.26px Barlow, sans-serif; text-anchor: middle; fill: #141413; pointer-events: none; }
  #planta :global(.cota) { font: 500 0.3px Barlow, sans-serif; text-anchor: middle; fill: #6d6a63; }

  @media (max-width: 1180px) {
    .area { grid-template-columns: 260px minmax(0, 1fr); }
    .res { grid-column: 1 / -1; }
  }
  @media (max-width: 760px) {
    .area { grid-template-columns: 1fr; }
    .palco { order: -1; }
    .cat :global(ul) { max-height: 300px; }
    .acoes { margin-left: 0; }
  }
</style>
